<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <ImageView android:id="@+id/fundo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/fundo_widget" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:gravity="center" android:padding="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
            <TextClock android:id="@+id/hora" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed" android:textSize="56dp" android:textColor="#FFFFFFFF" android:maxLines="1"
        android:includeFontPadding="false" android:format12Hour="h:mm" android:format24Hour="HH:mm" />
            <TextClock android:id="@+id/segundos" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed" android:textSize="22dp" android:textColor="#FFFFFFFF" android:maxLines="1"
        android:includeFontPadding="false" android:format12Hour="ss" android:format24Hour="ss" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:visibility="gone"/>
            <TextClock android:id="@+id/ampm" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed" android:textSize="16dp" android:textColor="#FFFFFFFF" android:maxLines="1"
        android:includeFontPadding="false" android:format12Hour="a" android:format24Hour="" android:layout_marginStart="6dp" android:layout_marginBottom="6dp"/>
        </LinearLayout>
        <TextClock android:id="@+id/data" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed" android:textSize="15dp" android:textColor="#FFFFFFFF" android:maxLines="1"
        android:includeFontPadding="false" android:format12Hour="EEE, d 'de' MMMM" android:format24Hour="EEE, d 'de' MMMM" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/extra" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed" android:textSize="13dp" android:textColor="#CCFFFFFF" android:maxLines="1"
        android:layout_marginTop="2dp" android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
