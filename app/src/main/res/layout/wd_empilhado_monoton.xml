<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <ImageView android:id="@+id/fundo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/fundo_widget" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:gravity="center" android:padding="8dp">
        <TextClock android:id="@+id/hora" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="@font/monoton" android:textSize="60dp" android:textColor="#FFFFFFFF" android:maxLines="1"
        android:includeFontPadding="false" android:format12Hour="hh" android:format24Hour="HH" />
        <TextClock android:id="@+id/minuto" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="@font/monoton" android:textSize="60dp" android:textColor="#FFFFFFFF" android:maxLines="1"
        android:includeFontPadding="false" android:format12Hour="mm" android:format24Hour="mm" android:layout_marginTop="-4dp"/>
        <TextClock android:id="@+id/data" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light" android:textSize="13dp" android:textColor="#FFFFFFFF" android:maxLines="1"
        android:includeFontPadding="false" android:format12Hour="EEE d MMM" android:format24Hour="EEE d MMM" android:layout_marginTop="4dp"/>
        <TextClock android:id="@+id/ampm" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light" android:textSize="12dp" android:textColor="#FFFFFFFF" android:maxLines="1"
        android:includeFontPadding="false" android:format12Hour="a" android:format24Hour="" android:visibility="gone"/>
        <TextView android:id="@+id/extra" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light" android:textSize="13dp" android:textColor="#CCFFFFFF" android:maxLines="1"
        android:layout_marginTop="2dp" android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
