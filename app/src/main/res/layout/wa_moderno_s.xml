<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <ImageView android:id="@+id/fundo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/fundo_widget" android:importantForAccessibility="no"/>
    <AnalogClock android:id="@+id/analogico" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_gravity="center" android:padding="6dp"
        android:dial="@drawable/mostrador_moderno" android:hand_hour="@drawable/ponteiro_moderno_h" android:hand_minute="@drawable/ponteiro_moderno_m" android:hand_second="@drawable/ponteiro_moderno_s"/>
</FrameLayout>
